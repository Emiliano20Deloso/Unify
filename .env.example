# Copia este archivo a .env.local y rellena los valores. El sitio arranca y compila sin ninguno.

# --- Sitio ---
# URL pública del sitio (metadataBase). Por defecto https://unify-eight.vercel.app
NEXT_PUBLIC_APP_URL=
# Nombre para títulos "Página | Nombre". Por defecto "Unify Luxury"
NEXT_PUBLIC_APP_NAME=
# Autor/creador en metadata. Por defecto "Unify Luxury"
NEXT_PUBLIC_AUTHOR_NAME=
# Base para el redirect del magic link del admin. Por defecto window.location.origin
NEXT_PUBLIC_SITE_URL=

# --- Supabase ---
# Sin URL + anon key: el proxy no hace nada, /admin muestra aviso y /api/quote responde 503
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor (inserta cotizaciones). Nunca exponer al cliente
SUPABASE_SERVICE_ROLE_KEY=

# --- Google Maps ---
# Llave de SERVIDOR (solo se lee en el servidor; nunca NEXT_PUBLIC_). Restringirla a Routes API y
# Places API (New) y fijar cuotas diarias en Google Cloud: ese es el tope real de costo.
# Sin llave el cotizador funciona con distancia aproximada y solo el catálogo de lugares.
GOOGLE_MAPS_SERVER_KEY=
# Opcional: "unaware" baja Routes a TRAFFIC_UNAWARE (más barato, sin tráfico). Por defecto TRAFFIC_AWARE
GOOGLE_ROUTES_TRAFFIC=

# --- Correo (Resend) ---
RESEND_API_KEY=
# Remitente verificado, p. ej. "Unify <no-reply@dominio>"
RESEND_FROM=
# Destinatario de los avisos de nuevas solicitudes
ADMIN_EMAIL=

# --- Scripts locales (scripts/test-api-quote.ts) ---
# Base del API a probar. Por defecto http://localhost:3000
API_BASE=
